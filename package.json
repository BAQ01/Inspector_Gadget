{
  "name": "scios-inspector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-recovered-source.mjs",
    "build:snapshot": "node scripts/prepare-production.mjs",
    "verify:production": "node scripts/verify-recovered-source.mjs",
    "verify:snapshot": "node scripts/verify-production-snapshot.mjs",
    "verify:security": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high",
    "verify:security:all": "npm audit --audit-level=moderate",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
